DATABASE_URL="your_neon_connection_string"
ADMIN_EMAIL="your-email@example.com"
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your_google_app_password"

# ==============================================================================
# ToolVerse Hybrid AI Provider Configuration
# ==============================================================================
# Default development provider: "ollama" (100% free, offline, zero API keys required)
# Options: "ollama" | "openai" | "vllm" | "gemini"
AI_PROVIDER="ollama"

# Ollama Configuration (Local Default)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Tool-Specific Model Overrides (Optional)
# OLLAMA_COMMIT_MODEL="llama3.2"
# OLLAMA_CODE_MODEL="qwen2.5-coder:7b"
# OLLAMA_README_MODEL="llama3.2"
# OLLAMA_APIDOCS_MODEL="qwen2.5-coder:7b"
# OLLAMA_EMAIL_MODEL="llama3.2"
# OLLAMA_FLOWCHART_MODEL="llama3.2"

# Optional Cloud Providers
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_API_KEY="AIzaSy..."
# GEMINI_MODEL="gemini-1.5-flash"
# VLLM_BASE_URL="http://localhost:8000"
# VLLM_MODEL="toolverse/general-coder-v1.0"