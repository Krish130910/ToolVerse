DATABASE_URL="your_neon_connection_string"
ADMIN_EMAIL="your-email@example.com"
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your_google_app_password"

# ==============================================================================
# ToolVerse AI Provider Configuration
# ==============================================================================
# Default AI Provider: "openrouter"
# Options: "openrouter" | "openai" | "gemini" | "vllm"
AI_PROVIDER="openrouter"

# OpenRouter Configuration (Free Model Tier Default)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openrouter/free"

# Tool-Specific Model Overrides (Optional free or paid models)
# OPENROUTER_COMMIT_MODEL="openrouter/free"
# OPENROUTER_CODE_MODEL="cohere/north-mini-code:free"
# OPENROUTER_README_MODEL="openrouter/free"
# OPENROUTER_APIDOCS_MODEL="openrouter/free"
# OPENROUTER_EMAIL_MODEL="openrouter/free"
# OPENROUTER_FLOWCHART_MODEL="openrouter/free"

# ==============================================================================
# OpenCode ACP GitHub Workflow Bot Configuration
# ==============================================================================
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_REPO="your-github-username/ToolVerse"
ADMIN_APPROVAL_SECRET="your-secret-phrase-for-hmac-email-approvals"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

