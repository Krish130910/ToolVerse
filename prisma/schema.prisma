// This is your Prisma schema file for ToolVerse (Neon PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ToolRequest {
  id        String   @id @default(cuid())
  toolName  String
  name      String?
  email     String
  message   String   @db.Text
  status    String   @default("Pending")
  createdAt DateTime @default(now())

  @@map("tool_requests")
}

model ShortUrl {
  id            String     @id @default(cuid())
  originalUrl   String     @db.Text
  shortCode     String     @unique
  customAlias   String?    @unique
  passwordHash  String?
  expiresAt     DateTime?
  clicks        Int        @default(0)
  createdAt     DateTime   @default(now())
  lastVisitedAt DateTime?
  visits        UrlVisit[]

  @@index([shortCode])
  @@index([customAlias])
  @@map("short_urls")
}

model UrlVisit {
  id         String   @id @default(cuid())
  shortUrlId String
  shortUrl   ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)
  country    String?
  browser    String?
  device     String?
  os         String?
  referrer   String?
  visitedAt  DateTime @default(now())

  @@index([shortUrlId])
  @@map("url_visits")
}
